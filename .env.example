# ==============================================================================
# Environment Variables Example for Nexora
# ==============================================================================
# Copy this file to '.env' and fill in the API keys for the providers you want to use.
# NOTE: Ollama runs offline locally and does not require an API key.

# --- Phase 2: Online Providers ---
# Groq (Get your key: https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (Get your key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Cerebras (Get your key: https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# Mistral AI (Get your key: https://console.mistral.ai/)
MISTRAL_API_KEY=

# Google Gemini (OpenAI-compatible endpoint, Get key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
